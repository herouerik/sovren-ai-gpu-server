__pycache__/
*.pyc
*.pyo
.pytest_cache/
# The entire data/ directory, not just the expected db filenames -- an
# archived/renamed db file (data/archive/monitor.db.bloated-YYYYMMDD) was
# found staged by a plain `git add -A` because it doesn't end in exactly
# `.db`, and the old narrower patterns below didn't catch it. data/ is
# always local, never meant to be committed (see README Quick Start) --
# ignore the whole directory rather than trying to enumerate filenames.
data/
*.db
*.db-shm
*.db-wal
.env
.venv/

# Real per-machine operational config -- describes *this* box's actual
# topology (service names, ports, models). Was committed directly until
# it became clear every machine running this needs a different one (GPU
# server vs. a laptop doing dashboard dev). config.yaml.example is the
# checked-in template; copy it to config.yaml and edit for your own box
# (see README Quick Start / Configuration).
config.yaml
